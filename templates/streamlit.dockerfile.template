FROM python:3.11-slim

WORKDIR /app

# Install system dependencies
RUN apt-get update && apt-get install -y \
    curl \
    build-essential \
    libexpat1 \
    && rm -rf /var/lib/apt/lists/*

# Global pip constraints applied to every install below.
# Guards against transitive deps whose newest release breaks Streamlit on arrival.
# 2026-08-14: starlette 1.4.0 made GZipResponder.__init__() require a keyword-only
# arg `thread_minimum_size`, which Streamlit's gzip middleware does not pass ->
# TypeError -> HTTP 500 on every gzip response (all browser requests). Streamlit
# itself now caps starlette<1.4.0 (>=1.61.1). Remove this only once the Streamlit
# version being deployed officially supports starlette>=1.4.0.
RUN printf 'starlette<1.4.0\n' > /tmp/constraints.txt

# Copy requirements first for better caching
COPY requirements.txt* ./

# Install CPU-only PyTorch when torch dependencies are detected.
# Cloud Run is CPU-only, so CUDA packages are unnecessary and waste ~2GB of space.
RUN if [ -f requirements.txt ] && grep -qiE 'torch|sentence-transformers|transformers' requirements.txt; then \
    pip install --no-cache-dir -c /tmp/constraints.txt torch --index-url https://download.pytorch.org/whl/cpu; \
fi

RUN if [ -f requirements.txt ]; then pip install --no-cache-dir -c /tmp/constraints.txt -r requirements.txt; fi

# Install streamlit only if the app did not already declare it. This respects the
# app's own pinned version instead of unconditionally upgrading to latest, and stays
# bounded by the constraints above.
RUN if ! python -c "import streamlit" 2>/dev/null; then \
    pip install --no-cache-dir -c /tmp/constraints.txt streamlit; \
fi

# Copy application code
COPY . .

# Create streamlit directory
RUN mkdir -p .streamlit

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=30s --retries=3 \
    CMD curl --fail http://localhost:8080/_stcore/health || exit 1

# Expose port
EXPOSE 8080

# Run streamlit
CMD ["streamlit", "run", "{MAIN_FILE}", "--server.port=8080", "--server.address=0.0.0.0", "--server.headless=true"]
